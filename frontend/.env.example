# Traffora-AI frontend configuration.
# Copy this file to `.env.local` and adjust the values for your machine.

# Base URL of the orchestrator HTTP API.
# The dashboard calls this directly from the browser, so the origin must be
# listed in the backend's TRAFFORA_CORS_ORIGINS.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Only used by the optional Vite dev proxy for the "/api" prefix.
# Leave the app pointed at VITE_API_BASE_URL unless you deliberately want to
# route through the proxy (which avoids CORS entirely during development).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
