<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <input>
    <!-- One shared network: the GreenCorridor 5x5 grid (21 signalised junctions). -->
    <net-file value="../green_corridor/sample_network/grid.net.xml"/>
    <route-files value="../green_corridor/scenarios/background.rou.xml,../green_corridor/scenarios/ambulance.rou.xml,parking_demand.rou.xml"/>
    <!-- signals.add.xml replaces the network's default programs with the same
         link mapping but explicit all-red clearance and declared green bounds,
         so both TrafficMind and the orchestrator's safety layer can reason
         about them. Generated by scripts/build_signal_programs.py. -->
    <additional-files value="../green_corridor/scenarios/vtypes.add.xml,../green_corridor/scenarios/hospital.add.xml,parking.add.xml,signals.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="1800"/>
    <step-length value="1"/>
  </time>
  <processing>
    <time-to-teleport value="-1"/>
    <waiting-time-memory value="300"/>
  </processing>
</configuration>
